# ESP-IDF 构建产物(launcher/ 与 apps/* 各工程都会生成)
build/
sdkconfig
sdkconfig.old

# 组件管理器拉取的托管依赖(由 idf_component.yml + *.lock 复现)
managed_components/

# Python 字节码缓存(tools/ 下的脚本被当模块 import 时生成)
__pycache__/
*.pyc

# tools/screenshot.py 抓的实机截图(默认落在仓库根,--watch 每按一次 BtnB 存一张)。
# 只是排查现场的一次性证据,别进版本库;确实要留档的截图放 docs/ 下并在文档里引用。
screenshot_*.png

# 各 app tools/preview.py 的离屏效果图(不带参数时落在当前目录)。同样是可再生的
# 一次性产物,要留档就放 docs/ 下并在文档里引用。
bp_*.png
ui_wide.png

# 编辑器/系统
.vscode/
.DS_Store
*.swp

# tilt_maze tools/preview_home.py 的家图标候选效果图(同上,可再生)
home_*.png
